# Keep the build context small and — the load-bearing line — keep secrets out
# of it. `gcloud run deploy --source` uploads this directory to Cloud Build, so
# anything not excluded here leaves the machine.
.env
.env.*
!.env.example

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

tests/
frontend/
docs/
*.md
!README.md

.DS_Store
Thumbs.db
.idea/
.vscode/
