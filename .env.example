# Copy to .env and fill in. .env is gitignored — never commit real values.
# The app fails fast at startup if any of these five are missing.
#
# It also fails if one is still set to the placeholder below, or to anything
# starting with REPLACE_ME / your-. A placeholder passes a presence check but
# fails on every real call, which surfaces as a report with no evidence in it —
# indistinguishable from an honest report about a thinly-documented company.
# That is the one failure mode this project refuses to allow, so it is caught at
# startup instead. DEMO_ACCESS_TOKEN additionally rejects local-dev-* tokens:
# the hosted demo is public and runs on a personal API key.

# Companies House REST API (free) — https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your-companies-house-key

# Tavily search API — https://tavily.com (free tier: 1,000 credits/month)
TAVILY_API_KEY=tvly-your-key

# Anthropic — primary LLM provider (Haiku extraction, Sonnet synthesis)
ANTHROPIC_API_KEY=sk-ant-your-key

# Google AI Studio — Gemini 2.0 Flash fallback provider
GOOGLE_API_KEY=your-google-ai-studio-key

# Shared token the evaluator sends as: Authorization: Bearer <token>
DEMO_ACCESS_TOKEN=generate-a-long-random-string

# --- Optional overrides (defaults in src/config.py are the intended values) ---
# PER_IP_REPORTS_PER_HOUR=5
# GLOBAL_REPORT_BUDGET=130
# BREAKER_FAILURE_THRESHOLD=3
# BREAKER_COOLDOWN_SECONDS=60
